# local build outputs (multi-GB qcow2/zst artifacts; keeping them out of git
# also keeps them out of any `git stash -u` during pulls)
build/
build-out-*/
build-failed-*/
build-*.log
*.qcow2
*.qcow2.xz
*.qcow2.zst
# the cross-compiled telnet server and the remastered install media are
# generated by hooks/host_beforeBuild.sh, never committed
*.exe
reactos-upstream.zip
# python bytecode caches (hooks/upstream_check.py imports gendata)
__pycache__/
*.pyc
# build.py web-console runtime leftovers
index.html
screen.txt
screen.png
_screenText.txt
